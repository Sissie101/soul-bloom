{
  "name": "SocialPerformance",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "tiktok",
        "instagram",
        "facebook",
        "linkedin",
        "organic"
      ],
      "description": "Social media platform"
    },
    "campaign_id": {
      "type": "string",
      "description": "Related campaign ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the metrics snapshot"
    },
    "reach": {
      "type": "number",
      "default": 0,
      "description": "Total unique users reached"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Total impressions"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Total link clicks"
    },
    "engagement": {
      "type": "number",
      "default": 0,
      "description": "Total engagements (likes, comments, shares)"
    },
    "conversions": {
      "type": "number",
      "default": 0,
      "description": "Total conversions attributed"
    },
    "spend": {
      "type": "number",
      "default": 0,
      "description": "Ad spend for the period"
    },
    "followers_gained": {
      "type": "number",
      "default": 0,
      "description": "New followers gained"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this performance snapshot",
      "maxLength": 1000
    }
  },
  "required": [
    "platform",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}